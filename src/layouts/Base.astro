---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CursorGlow from '../components/CursorGlow';
import { ClientRouter } from 'astro:transitions';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props { title?: string; description?: string }
const { title, description = 'Jordan Barhoumeh: data scientist, AI engineer and app developer.' } = Astro.props;
const rise = {
  forwards: { old: { name: 'rise-out', duration: '0.18s', easing: 'ease-in', fillMode: 'forwards' }, new: { name: 'rise-in', duration: '0.45s', easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fillMode: 'backwards' } },
  backwards: { old: { name: 'rise-out', duration: '0.18s', easing: 'ease-in', fillMode: 'forwards' }, new: { name: 'rise-in', duration: '0.45s', easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fillMode: 'backwards' } },
};
const fullTitle = title ? `${title} · Jordan Barhoumeh` : 'Jordan Barhoumeh';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <ClientRouter />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        else if (matchMedia('(prefers-color-scheme: light)').matches) document.documentElement.dataset.theme = 'light';
      } catch {}
      // keep the chosen theme across client-side page swaps
      document.addEventListener('astro:before-swap', (e) => {
        const t = document.documentElement.dataset.theme;
        if (t) e.newDocument.documentElement.dataset.theme = t;
        else delete e.newDocument.documentElement.dataset.theme;
      });
    </script>
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-primary focus:px-3 focus:py-2 focus:text-bg">Skip to content</a>
    <CursorGlow client:only="react" transition:persist />
    <Nav />
    <main id="main" transition:animate={rise}><slot /></main>
    <Footer />
    <script>
      // scroll-in reveal for .reveal elements (re-run after each client-side navigation)
      function initReveal() {
        const els = document.querySelectorAll<HTMLElement>('.reveal:not(.in)');
        // content already on screen is shown immediately; only what is below the fold animates in
        els.forEach((el) => {
          if (el.getBoundingClientRect().top < innerHeight) el.classList.add('in', 'instant');
        });
        document.documentElement.classList.add('reveal-ready');
        if (!('IntersectionObserver' in window)) return els.forEach((el) => el.classList.add('in'));
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }, { rootMargin: '0px 0px -8% 0px' });
        els.forEach((el) => { if (!el.classList.contains('in')) io.observe(el); });
      }
      document.addEventListener('astro:page-load', initReveal);
    </script>
    <script>
      // cursor-following spotlight for .spot cards
      document.addEventListener('pointermove', (e) => {
        const el = (e.target as Element).closest?.('.spot') as HTMLElement | null;
        if (!el) return;
        const r = el.getBoundingClientRect();
        el.style.setProperty('--mx', `${e.clientX - r.left}px`);
        el.style.setProperty('--my', `${e.clientY - r.top}px`);
      }, { passive: true });
    </script>
  </body>
</html>

---
import Base from '../layouts/Base.astro';
import { about, volunteering } from '../data/profile';

const paragraphs = about.split('\n\n');
const facts = [
  { k: 'Role', v: 'AI/ML Engineer, News Corp Australia' },
  { k: 'Studied', v: 'BTech Data Science, Macquarie University' },
  { k: 'By night', v: 'Self-taught app developer' },
  { k: 'Based in', v: 'Australia' },
];
---
<Base title="About" description="About Jordan Barhoumeh: AI/ML engineer by day, self-taught app dev by night.">
  <section class="mx-auto max-w-5xl px-6 pb-12 pt-32">
    <p class="font-mono text-sm text-primary">About</p>
    <h1 class="mt-3 max-w-3xl text-5xl font-semibold leading-[1.02] sm:text-7xl">Hi, I'm Jordan<span class="text-primary">.</span></h1>
  </section>

  <section class="mx-auto grid max-w-5xl gap-12 px-6 pb-24 lg:grid-cols-[1fr_320px]">
    <div class="space-y-6 text-lg leading-relaxed text-text/85">
      {paragraphs.map((p, i) => <p class="reveal" style={`transition-delay:${i * 90}ms`}>{p}</p>)}
    </div>

    <aside class="reveal h-fit rounded-2xl border border-border bg-surface p-6 lg:sticky lg:top-28" aria-label="Quick facts">
      <div class="mb-6 grid h-20 w-20 place-items-center rounded-2xl text-2xl font-semibold text-bg"
        style="background:radial-gradient(80% 90% at 25% 25%, var(--primary), var(--accent))" aria-hidden="true">JB</div>
      <dl class="space-y-4">
        {facts.map((f) => (
          <div>
            <dt class="font-mono text-xs uppercase tracking-wider text-muted">{f.k}</dt>
            <dd class="mt-1">{f.v}</dd>
          </div>
        ))}
      </dl>
    </aside>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-24">
    <div class="reveal">
      <p class="font-mono text-sm text-primary">Outside of work</p>
      <h2 class="mt-2 text-3xl font-semibold sm:text-4xl">Giving back</h2>
    </div>
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {volunteering.map((v, i) => (
        <div class="reveal rounded-2xl border border-border bg-surface p-6" style={`transition-delay:${i * 90}ms`}>
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="text-xl font-semibold">{v.role}</h3>
            <span class="font-mono text-xs tabular-nums text-muted">{v.startDate} — {v.endDate}</span>
          </div>
          <p class="mt-1 text-primary">{v.organization}</p>
          <p class="mt-4 text-text/80">{v.description}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-28">
    <div class="reveal flex flex-wrap items-center justify-between gap-4 rounded-3xl border border-border bg-surface p-8 sm:p-10">
      <div>
        <h2 class="text-2xl font-semibold sm:text-3xl">Want to work together?</h2>
        <p class="mt-2 text-muted">The best way to reach me is email.</p>
      </div>
      <a href="/contact" class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-medium text-bg transition-transform hover:scale-[1.03]">Get in touch</a>
    </div>
  </section>
</Base>

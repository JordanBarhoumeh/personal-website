---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Projects" description="Selected projects: AI applications and machine learning work, with write-ups of how they were built.">
  <section class="mx-auto max-w-5xl px-6 pb-12 pt-32">
    <p class="font-mono text-sm text-primary">Projects</p>
    <h1 class="mt-3 max-w-3xl text-5xl font-semibold leading-[1.02] sm:text-7xl">Things I have built<span class="text-primary">.</span></h1>
    <p class="mt-6 max-w-xl text-lg text-muted">Each one has a write-up of what it does and how it works. More are on the way as I build them in public.</p>
  </section>
  <section class="mx-auto max-w-5xl px-6 pb-28">
    <div class="grid gap-5 md:grid-cols-2">
      {projects.map((p, i) => (
        <ProjectCard as="h2" slug={p.id} index={i} large {...p.data} />
      ))}
    </div>
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="That page does not exist.">
  <section class="mx-auto flex min-h-[80dvh] max-w-3xl flex-col justify-center px-6 pb-16 pt-32">
    <p class="font-mono text-sm text-primary">404</p>
    <h1 class="mt-3 text-5xl font-semibold leading-[1.02] sm:text-7xl">Lost in the data<span class="text-primary">.</span></h1>
    <p class="mt-6 max-w-lg text-lg text-muted">That page does not exist, or it moved. Here are some places that do.</p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/" class="rounded-full bg-primary px-6 py-3 text-sm font-medium text-bg transition-transform hover:scale-[1.03]">Back home</a>
      <a href="/projects" class="rounded-full border border-border px-6 py-3 text-sm font-medium transition-colors hover:border-primary/60">Projects</a>
      <a href="/blog" class="rounded-full border border-border px-6 py-3 text-sm font-medium transition-colors hover:border-primary/60">Blog</a>
    </div>
  </section>
</Base>

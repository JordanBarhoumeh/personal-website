---
import { render, getEntry } from 'astro:content';
import { ArrowLeft, ArrowRight } from 'lucide-react';
import Base from '../../layouts/Base.astro';
import { getPosts, readingTime, formatDate } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}
const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const project = d.project ? await getEntry('projects', d.project) : undefined;
---
<Base title={d.title} description={d.description}>
  <div id="read-progress" aria-hidden="true" class="fixed inset-x-0 top-0 z-[60] h-[3px] origin-left scale-x-0 bg-gradient-to-r from-primary to-accent"></div>

  <div class="mx-auto max-w-5xl px-6 pb-24 pt-32 lg:grid lg:grid-cols-[1fr_200px] lg:gap-14">
    <article class="mx-auto min-w-0 max-w-[68ch] lg:mx-0">
      <a href="/blog" class="inline-flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-text"><ArrowLeft className="h-4 w-4" /> All posts</a>

      <div class="mt-8 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs tabular-nums text-muted">
        <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime(post.body)} min read</span>
        {d.draft && <span class="rounded-full border border-primary/60 px-2 py-0.5 text-primary">draft</span>}
      </div>
      <h1 class="mt-4 text-4xl font-semibold leading-[1.08] sm:text-5xl">{d.title}</h1>
      <p class="mt-5 text-lg text-muted">{d.description}</p>
      {d.tags.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-2" aria-label="Tags">
          {d.tags.map((t) => <li class="rounded-full border border-border px-3 py-1 font-mono text-xs text-muted">{t}</li>)}
        </ul>
      )}

      {project && (
        <a href={`/projects/${project.id}`} class="group mt-8 flex items-center justify-between rounded-xl border border-border bg-surface px-4 py-3 transition-colors hover:border-primary/60">
          <span class="text-sm"><span class="font-mono text-xs text-muted">Part of the build log for</span><br /><span class="font-medium group-hover:text-primary">{project.data.title}</span></span>
          <ArrowRight className="h-4 w-4 text-muted transition-transform group-hover:translate-x-1 group-hover:text-primary" />
        </a>
      )}

      <div class="prose prose-lg mt-12 max-w-none" id="post-body">
        <Content />
      </div>

      <nav class="mt-20 grid gap-4 border-t border-border pt-8 sm:grid-cols-2" aria-label="More posts">
        {older ? (
          <a href={`/blog/${older.id}`} class="group rounded-xl border border-border p-4 transition-colors hover:border-primary/60">
            <span class="inline-flex items-center gap-1 font-mono text-xs text-muted"><ArrowLeft className="h-3.5 w-3.5" /> Older</span>
            <span class="mt-1 block font-medium group-hover:text-primary">{older.data.title}</span>
          </a>
        ) : <span />}
        {newer && (
          <a href={`/blog/${newer.id}`} class="group rounded-xl border border-border p-4 text-right transition-colors hover:border-primary/60">
            <span class="inline-flex items-center gap-1 font-mono text-xs text-muted">Newer <ArrowRight className="h-3.5 w-3.5" /></span>
            <span class="mt-1 block font-medium group-hover:text-primary">{newer.data.title}</span>
          </a>
        )}
      </nav>
    </article>

    {toc.length > 1 && (
      <aside class="hidden lg:block" aria-label="Table of contents">
        <nav class="sticky top-28" id="toc">
          <p class="font-mono text-xs uppercase tracking-wider text-muted">On this page</p>
          <ul class="mt-4 space-y-2.5 border-l border-border text-sm">
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`} data-id={h.slug}
                  class:list={['-ml-px block border-l border-transparent py-0.5 text-muted transition-colors hover:text-text', h.depth === 3 ? 'pl-7' : 'pl-4']}>{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    )}
  </div>
</Base>

<style is:global>
  #toc a.active { color: var(--text); border-left-color: var(--primary); }
</style>

<script>
  function initPost() {
    const bar = document.getElementById('read-progress');
    const body = document.getElementById('post-body');
    if (!bar || !body) return;

    const update = () => {
      const r = body.getBoundingClientRect();
      const total = r.height - window.innerHeight * 0.6;
      const p = Math.min(1, Math.max(0, (-r.top + window.innerHeight * 0.2) / Math.max(1, total)));
      bar.style.transform = `scaleX(${p})`;
    };
    update();
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    document.addEventListener('astro:before-swap', () => {
      removeEventListener('scroll', update);
      removeEventListener('resize', update);
    }, { once: true });

    // highlight the current section in the table of contents
    const links = new Map<string, Element>();
    document.querySelectorAll<HTMLAnchorElement>('#toc a').forEach((a) => links.set(a.dataset.id!, a));
    const heads = [...body.querySelectorAll<HTMLElement>('h2[id], h3[id]')];
    if (links.size && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((a) => a.classList.remove('active'));
          links.get(e.target.id)?.classList.add('active');
        }
      }, { rootMargin: '-15% 0px -70% 0px' });
      heads.forEach((h) => io.observe(h));
    }

    // copy buttons on code blocks
    body.querySelectorAll<HTMLElement>('pre.astro-code').forEach((pre) => {
      if (pre.parentElement?.classList.contains('code-wrap')) return;
      const wrap = document.createElement('div');
      wrap.className = 'code-wrap';
      pre.replaceWith(wrap);
      wrap.appendChild(pre);
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'code-copy';
      btn.textContent = 'Copy';
      btn.setAttribute('aria-label', 'Copy code to clipboard');
      btn.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(pre.innerText); btn.textContent = 'Copied'; }
        catch { btn.textContent = 'Press ⌘C'; }
        setTimeout(() => (btn.textContent = 'Copy'), 1600);
      });
      wrap.appendChild(btn);
    });
  }
  document.addEventListener('astro:page-load', initPost);
</script>

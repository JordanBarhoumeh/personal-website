---
import Base from '../layouts/Base.astro';
import ExperienceTimeline from '../components/ExperienceTimeline';
import SpotlightCard from '../components/SpotlightCard';
import { experiences, education, skillGroups, certifications } from '../data/profile';
---
<Base title="Experience" description="Where I have worked, what I studied, and the tools I use.">
  <section class="mx-auto max-w-5xl px-6 pb-12 pt-24">
    <p class="font-mono text-sm text-primary">Experience</p>
    <h1 class="mt-3 max-w-3xl text-5xl font-semibold leading-[1.02] sm:text-7xl">Where I have worked<span class="text-primary">.</span></h1>
    <p class="mt-6 max-w-xl text-lg text-muted">From running a team on the floor to shipping ML in production. Newest first.</p>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-24">
    <ExperienceTimeline client:load items={experiences} />
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-24">
    <p class="font-mono text-sm text-primary">Education</p>
    <div class="mt-6">
      <SpotlightCard client:load className="p-6 sm:p-8">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h2 class="text-xl font-semibold sm:text-2xl">{education.institution}</h2>
          <span class="font-mono text-xs tabular-nums text-muted">{education.startDate} — {education.endDate}</span>
        </div>
        <p class="mt-2 text-primary">{education.degree}</p>
      </SpotlightCard>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-24">
    <p class="font-mono text-sm text-primary">Toolbox</p>
    <h2 class="mt-2 text-3xl font-semibold sm:text-4xl">Skills</h2>
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {skillGroups.map((g) => (
        <SpotlightCard client:visible className="p-6">
          <h3 class="font-mono text-xs uppercase tracking-wider text-muted">{g.category}</h3>
          <ul class="mt-4 flex flex-wrap gap-2">
            {g.skills.map((s) => (
              <li class="rounded-full border border-border px-3 py-1 text-sm transition-colors hover:border-primary/60 hover:text-primary">{s}</li>
            ))}
          </ul>
        </SpotlightCard>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-28">
    <p class="font-mono text-sm text-primary">Learning</p>
    <h2 class="mt-2 text-3xl font-semibold sm:text-4xl">Certifications</h2>
    <ul class="mt-8 divide-y divide-border border-y border-border">
      {certifications.map((c) => (
        <li class="flex items-baseline justify-between gap-6 py-4">
          <span>{c.name} <span class="text-muted">· {c.issuer}</span></span>
          <span class="shrink-0 font-mono text-xs tabular-nums text-muted">{c.date}</span>
        </li>
      ))}
    </ul>
  </section>
</Base>

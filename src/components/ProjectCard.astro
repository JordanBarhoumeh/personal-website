---
import { ArrowUpRight } from 'lucide-react';
import ProjectCover from './ProjectCover.astro';
interface Props { slug: string; title: string; summary: string; period: string; kind: string; tags: string[]; index: number; large?: boolean }
const { slug, title, summary, period, kind, tags, index, large } = Astro.props;
---
<a href={`/projects/${slug}`} class="spot group relative flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-surface p-3 transition-transform duration-300 hover:-translate-y-1">
  <div class="pointer-events-none absolute -inset-px opacity-0 transition-opacity duration-300 group-hover:opacity-100"
    style="background:radial-gradient(420px circle at var(--mx,50%) var(--my,50%), color-mix(in oklab, var(--primary) 18%, transparent), transparent 60%)"></div>
  <ProjectCover index={index} name={`cover-${slug}`} class:list={[large ? 'h-56 sm:h-72' : 'h-44']}>
    <span class="absolute left-3 top-3 rounded-full border border-white/25 bg-black/25 px-3 py-1 font-mono text-xs text-white backdrop-blur">{kind}</span>
  </ProjectCover>
  <div class="relative flex flex-1 flex-col p-4">
    <div class="flex items-start justify-between gap-4">
      <h3 class="text-xl font-semibold leading-snug sm:text-2xl" transition:name={`title-${slug}`}>{title}</h3>
      <ArrowUpRight className="mt-1 h-5 w-5 shrink-0 text-muted transition-all group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-primary" />
    </div>
    <p class="mt-3 text-muted">{summary}</p>
    <div class="mt-auto flex flex-wrap items-center gap-2 pt-5">
      <span class="font-mono text-xs tabular-nums text-muted">{period}</span>
      {tags.slice(0, 3).map((t) => <span class="rounded-full border border-border px-2.5 py-0.5 font-mono text-[11px] text-muted">{t}</span>)}
    </div>
  </div>
</a>

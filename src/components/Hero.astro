---
import { ArrowDown } from 'lucide-react';
import HeroGradientLoader from './HeroGradientLoader';
import HeroActions from './HeroActions';

const lines = ['Data Scientist', 'AI Engineer', 'App Dev'];
---
<section class="relative isolate overflow-hidden">
  <!-- static glow: paints immediately and stays as the fallback for reduced motion / weak devices -->
  <div class="absolute inset-0 -z-20 bg-[radial-gradient(ellipse_at_70%_30%,var(--secondary),transparent_60%)]"></div>
  <HeroGradientLoader client:idle />

  <div class="mx-auto flex min-h-[88dvh] max-w-5xl flex-col justify-center px-6 pb-20 pt-28">
    <div class="hero-fade mb-8 inline-flex w-fit items-center gap-2 rounded-full border border-border bg-surface/60 px-4 py-1.5 backdrop-blur" style="--d:.05s">
      <span class="relative flex h-2 w-2">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-primary opacity-60"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-primary"></span>
      </span>
      <span class="animate-shiny-text bg-linear-to-r from-transparent via-primary to-transparent bg-size-[100px_100%] bg-clip-text bg-position-[0_0] bg-no-repeat text-sm text-text/70">Now building in public</span>
    </div>

    <h1 class="max-w-4xl text-6xl font-semibold leading-[1.02] sm:text-8xl">
      {lines.map((line, i) => (
        <span class="hero-line">
          <span style={`--i:${i}`}>{line}{i === lines.length - 1 && <span class="hero-pop text-primary">.</span>}</span>
        </span>
      ))}
    </h1>

    <p class="hero-fade mt-8 max-w-xl text-lg text-text/80 sm:text-xl" style="--d:.55s">
      Jordan Barhoumeh. AI/ML engineer by day, self-taught app dev by night.
    </p>

    <div class="hero-fade mt-10 min-h-[46px]" style="--d:.7s">
      <HeroActions client:load />
    </div>

    <div class="hero-bob absolute bottom-8 left-1/2 -translate-x-1/2 text-muted" aria-hidden="true">
      <ArrowDown className="h-5 w-5" />
    </div>
  </div>
</section>
